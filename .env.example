# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit .env

PORT=3000
NODE_ENV=development

# MongoDB
# Local:  mongodb://localhost:27017/auth_db
# Atlas:  mongodb+srv://USER:PASS@cluster.xxxx.mongodb.net/auth_db
MONGODB_URI=mongodb://localhost:27017/auth_db

# CORS - hỗ trợ nhiều origin, phân cách bằng dấu phẩy
# Ví dụ: http://localhost:5173,https://my-app.vercel.app
CLIENT_URL=http://localhost:5173

# JWT secrets - PHẢI khác nhau và phải random
# Sinh chuỗi mới: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=thay_bang_chuoi_random_64_ky_tu
JWT_REFRESH_SECRET=thay_bang_chuoi_random_KHAC_voi_access
